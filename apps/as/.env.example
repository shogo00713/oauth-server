# 認可サーバー(AS)の設定
#   cp .env.example .env
ISSUER=http://localhost:4000
PORT=4000
SIGNING_KEY_PATH=../../keys/as-private.pem

# 以下は、省略できる
# AUDIENCE=simple-memo
# CODE_TTL_SEC=60
# ACCESS_TOKEN_TTL_SEC=600
# DEFAULT_SCOPE=read

# 登録済みのクライアント
CLIENT_ID=memoboard
CLIENT_NAME=メモボード
# 32 文字以上。作り方:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CLIENT_SECRET=
# 空白で区切って、複数書ける
CLIENT_REDIRECT_URIS=http://localhost:3000/callback

# ログインするユーザー(開発用の 1 人)
USER_NAME=demo
# 12 文字以上
USER_PASSWORD=