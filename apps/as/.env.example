# 認可サーバー（ AS ）の設定

# --------------------------------
# 初期配置 : 'cp .env.example .env'
# --------------------------------

# --------------------------------
# クライアントシークレットと、セッションシークレットの作成例
# 乱数生成: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# --------------------------------

# ----- AS 自身 -----
# AS の URL
ISSUER=http://localhost:4001
# AS のポート番号
PORT=4000
# AS が JWT で署名するための秘密鍵のパス
SIGNING_KEY_PATH=../../keys/as-private.pem
# セッション Cookie 署名の秘密
SESSION_SECRET=

# ----- 発行するトークンに含める情報 -----
AUDIENCE=simple-memo
CODE_TTL_SEC=60
ACCESS_TOKEN_TTL_SEC=600
DEFAULT_SCOPE=read


# ----- 以下は、本来 DB に置くべきもの -----

# 登録済みのクライアント情報 （ 開発用の暫定1個 ）
CLIENT_ID=memoboard
CLIENT_NAME=メモボード
CLIENT_SECRET=
CLIENT_REDIRECT_URIS=http://localhost:4001/callback

# サービスに登録済みのユーザー（ 開発用の暫定1人 ）
USER_NAME=demo
USER_PASSWORD= #12文字以上（自分で作って）

