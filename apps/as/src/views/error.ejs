<!doctype html>
<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>エラー | 認可サーバー</title>
        <style>
            body {
                margin: 0;
                font-family:
                    system-ui,
                    -apple-system,
                    'Hiragino Sans',
                    sans-serif;
                background: #f4f5f7;
                color: #222;
            }
            main {
                max-width: 32rem;
                margin: 4rem auto;
                padding: 2rem;
                background: #fff;
                border-radius: 12px;
                box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            }
            h1 {
                margin-top: 0;
                font-size: 1.25rem;
            }
            p {
                line-height: 1.7;
            }
            .hint {
                color: #666;
                font-size: 0.875rem;
            }
        </style>
    </head>
    <body>
        <main>
            <h1>エラー</h1>
            <p id="message"><%= message %></p>
            <p class="hint">このページを閉じて、アプリに戻ってください。</p>
        </main>
    </body>
</html>
