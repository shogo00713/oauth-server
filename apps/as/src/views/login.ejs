<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ログイン | 認可サーバー</title>
    <style>
        body {
            margin: 0;
            font-family: system-ui, -apple-system, "Hiragino Sans", sans-serif;
            background: #f4f5f7;
            color: #222;
        }
        main {
            max-width: 26rem;
            margin: 4rem auto;
            padding: 2rem;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        }
        h1 {
            margin-top: 0;
            font-size: 1.25rem;
        }
        p {
            line-height: 1.7;
        }
        label {
            display: block;
            margin-top: 1rem;
            font-size: 0.875rem;
            color: #444;
        }
        input[type="text"],
        input[type="password"] {
            display: block;
            box-sizing: border-box;
            width: 100%;
            margin-top: 0.25rem;
            padding: 0.6rem 0.75rem;
            font-size: 1rem;
            border: 1px solid #bbb;
            border-radius: 8px;
        }
        button {
            width: 100%;
            margin-top: 1.5rem;
            padding: 0.7rem;
            font-size: 1rem;
            color: #fff;
            background: #2457d6;
            border: 0;
            border-radius: 8px;
            cursor: pointer;
        }
        .error {
            padding: 0.6rem 0.75rem;
            color: #a11;
            background: #fdecec;
            border-radius: 8px;
        }
    </style>
</head>
<body>
    <main>
        <h1>ログイン</h1>
        <p><strong><%= clientName %></strong> が、あなたのアカウントを使うために、ログインを求めています。</p>
        <% if (locals.error) { %>
        <p class="error" role="alert"><%= error %></p>
        <% } %>
        <form method="post" action="/login">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label>ユーザー名
                <input type="text" name="username" value="<%= username %>" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
            </label>
            <label>パスワード
                <input type="password" name="password" autocomplete="current-password" required>
            </label>
            <button type="submit">ログイン</button>
        </form>
    </main>
</body>
</html>