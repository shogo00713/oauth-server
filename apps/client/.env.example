# メモボード(client)の設定
#   cp .env.example .env
# 自分の URL。AS に登録した戻り先(apps/as/.env の CLIENT_REDIRECT_URIS)は、
# 「この URL + /callback」と、一字一句同じにする
BASE_URL=http://localhost:4001
PORT=4001
# AS と RS の URL(AS の ISSUER、RS の PORT と、合わせる)
AS_BASE_URL=http://localhost:4000
RS_BASE_URL=http://localhost:4002

# AS に登録した物と、同じ値にする(apps/as/.env の CLIENT_SECRET)
CLIENT_SECRET=

# セッションの Cookie の署名の秘密(32 文字以上)。作り方:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 以下は、省略できる
# CLIENT_ID=memoboard
# REQUESTED_SCOPE=read write