# クライアントの設定

# --------------------------------
# 初期配置 : 'cp .env.example .env'
# --------------------------------

# --------------------------------
# クライアントシークレットと、セッションシークレットの作成例
# 乱数生成: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# --------------------------------

# ----- client 自身 -----
# client の URL
BASE_URL=http://localhost:3000
# client のポート番号
PORT=3000
# セッション Cookie 署名の秘密
SESSION_SECRET=
# 認可リクエストで要求する最大スコープ
REQUESTED_SCOPE=read write

# ----- AS の情報 -----
# AS の URL
AS_BASE_URL=http://localhost:4001

# ----- AS からもらった情報 -----
# AS に示す client の ID
CLIENT_ID=memoboard
# AS が発行してくれたクライアントシークレットの提示
CLIENT_SECRET=

# ----- RS の API -----
# RS の URL
RS_BASE_URL=http://localhost:4000