# シンプルメモアプリ(RS)の設定
#   cp .env.example .env
# ISSUER は、AS の設定(apps/as/.env)と、一字一句同じ値にする
ISSUER=http://localhost:4000
PORT=4002
# AS の公開鍵(pnpm --filter @oauth/as gen:key で作った物)
VERIFY_KEY_PATH=../../keys/as-public.pem

# 以下は、省略できる(AUDIENCE は、AS の設定と同じ値にする)
# AUDIENCE=simple-memo
# CLOCK_TOLERANCE_SEC=0