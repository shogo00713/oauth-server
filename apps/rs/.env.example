# リソースサーバー（ RS ）の設定

# --------------------------------
# 初期配置 : 'cp .env.example .env'
# --------------------------------

# ----- RS 自身 -----
# RS のポート番号
PORT=4000
# SQLite のデータがある場所のパス
DB_PATH=../../data/rs.db

# ----- AS のための設定 -----
# AS の URL
ISSUER=http://localhost:4001
# AS の JWT の公開鍵
VERIFY_KEY_PATH=../../keys/as-public.pem
# この RS の名前の宣伝
AUDIENCE=simple-memo
# 時計のずれを許す秒数
CLOCK_TOLERANCE_SEC=0